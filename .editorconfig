# How the files of this repository are laid out; editors that know EditorConfig follow it.
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# the kernel, the loader, the user space and the tests follow XNU: tabs, eight columns wide
[*.{c,h,cpp,s,S,m,mm,metal}]
indent_style = tab
indent_size = 8

[*.sh]
indent_style = tab
indent_size = 8

[Makefile]
indent_style = tab

[*.{py,toml,yml}]
indent_style = space
indent_size = 4

# Markdown: a trailing double space is a line break
[*.md]
indent_style = space
trim_trailing_whitespace = false

# Apple's files as they are changed: a patch keeps the whitespace of what it patches
[*.patch]
trim_trailing_whitespace = false
insert_final_newline = false
