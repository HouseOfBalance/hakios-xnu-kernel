# The changes to Apple's own files, one patch a topic. (The files HakiOS adds are not here: they are
# kernel/overlay/, as they are.)
#
# Every changed file of the tree belongs to exactly one patch: the first line below with a pattern
# that matches it -- a directory (ending in /), a path, or a glob. kernel/assemble.sh applies the
# patches in this order; kernel/export.sh writes them from an assembled tree by this table and stops
# at a changed file no line claims. What each patch is for: kernel/patches/README.md.
#
# patch                         files

# What is compiled and how: the build with upstream clang on Linux and with the Command Line Tools on
# macOS, the configuration, the lists of files, headers Apple's own compiler needs nothing for.
0001-build.patch                Makefile SETUP/ makedefs/ config/ tools/lldbmacros/
0001-build.patch                bsd/conf/ iokit/conf/ libkern/conf/ osfmk/conf/
0001-build.patch                libkern/libkern/c++/OSData.h osfmk/kern/kalloc.h

# A generic arm64 machine: the boot protocol of our loader, a CPU without pointer authentication,
# interrupts, timers, the console.
0002-platform-arm64.patch       pexpert/ osfmk/arm/ osfmk/arm64/ osfmk/console/ bsd/dev/arm/km.c

# IOKit without Apple's platform drivers.
0003-iokit.patch                iokit/

# Mach: scheduling, per-CPU data, panics and what is logged about them.
0004-mach.patch                 osfmk/kern/ bsd/kern/sys_work_interval.c

# Virtual memory as BSD sees it: the shared region.
0005-vm.patch                   bsd/vm/

# Processes: exec, code signing, entitlements, signals, sockets, system calls.
0006-bsd-process.patch          bsd/kern/ bsd/dev/arm/ bsd/sys/uio_internal.h

# File systems: the root in memory or on the flash, APFS and ramfs registered, code that was left
# to rot in the open release (mockfs, NFS's server, quotas).
0007-vfs.patch                  bsd/vfs/ bsd/miscfs/ bsd/nfs/ bsd/dev/memdev.c bsd/sys/disk.h security/mac_vfs_subr.c
