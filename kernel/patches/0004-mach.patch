diff --git a/osfmk/kern/bsd_kern.c b/osfmk/kern/bsd_kern.c
--- a/osfmk/kern/bsd_kern.c
+++ b/osfmk/kern/bsd_kern.c
@@ -1510,3 +1510,81 @@ bsd_to_mach_failure(int bsd_err)
 		return KERN_FAILURE;
 	}
 }
+
+/*
+ * every thread of a task, by its user registers and frame pointers -- for a daemon that answers
+ * nobody and in which no thread of ours runs (mediaserverd on the first phone, runs 248-265), seen from here
+ * without asking anything of it. The task's and each thread's suspend counts first (a task held by
+ * task_suspend runs no thread at all), then for each thread its state, user pc, lr and up to 9 return
+ * addresses, raw (the shared cache's slide is the same for every process: the caller knows it).
+ * Said through `say`, a line each; at most 40 threads. bsd/dev/hakios_ustack.c is the sysctl.
+ */
+#if defined(__arm64__)
+#include <arm/thread.h>
+
+void hakios_task_ustacks(task_t task, void (*say)(const char *, ...));
+
+void
+hakios_task_ustacks(task_t task, void (*say)(const char *, ...))
+{
+	struct {
+		uint64_t pc, lr, fp;
+		int state, suspended;
+		uint32_t user_ms, system_ms;
+	} seen[40];
+	unsigned count = 0, total = 0;
+	int task_suspended;
+	thread_t thread;
+	vm_map_t map;
+
+	task_lock(task);
+	task_suspended = (int)task->suspend_count;
+	map = task->map;
+	vm_map_reference(map);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		struct arm_saved_state *regs = get_user_regs(thread);
+
+		total++;
+		if (count == 40 || regs == NULL) {
+			continue;
+		}
+		seen[count].pc = get_saved_state_pc(regs);
+		seen[count].lr = get_saved_state_lr(regs);
+		seen[count].fp = get_saved_state_fp(regs);
+		seen[count].state = thread->state;
+		seen[count].suspended = (int)thread->suspend_count + (int)thread->user_stop_count;
+		{
+			/* its CPU time so far, in user space and in the kernel (where a thread spinning through
+			 * the kernel shows, which its user stack cannot) */
+			time_value_t user, system;
+
+			thread_read_times(thread, &user, &system, NULL);
+			seen[count].user_ms = (uint32_t)(user.seconds * 1000 + user.microseconds / 1000);
+			seen[count].system_ms = (uint32_t)(system.seconds * 1000 + system.microseconds / 1000);
+		}
+		count++;
+	}
+	task_unlock(task);
+	say("ustack: %u threads, the task suspended %d time(s)", total, task_suspended);
+	for (unsigned i = 0; i < count; i++) {
+		char line[200];
+		size_t used;
+		uint64_t fp = seen[i].fp;
+
+		used = (size_t)snprintf(line, sizeof(line), "ustack t%u state %#x stops %d cpu %u+%u ms: %llx %llx", i, seen[i].state,
+		    seen[i].suspended, seen[i].user_ms, seen[i].system_ms, (unsigned long long)seen[i].pc, (unsigned long long)seen[i].lr);
+		for (unsigned k = 0; k < 9 && fp != 0 && (fp & 7) == 0 && used < sizeof(line); k++) {
+			uint64_t frame[2];
+
+			if (copyinmap(map, (vm_map_offset_t)fp, frame, sizeof(frame)) != KERN_SUCCESS) {
+				break;
+			}
+			used += (size_t)snprintf(line + used, sizeof(line) - used, " %llx",
+			    (unsigned long long)(frame[1] & 0x0000000fffffffffULL));
+			fp = frame[0] > fp ? frame[0] : 0;
+		}
+		say("%s", line);
+	}
+	vm_map_deallocate(map);
+}
+#endif
